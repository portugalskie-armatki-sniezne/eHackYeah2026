POSTGRES_DB=app_db
POSTGRES_USER=app_user
POSTGRES_PASSWORD=replace_me
POSTGRES_PORT=5432

# generate with: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
JWT_SECRET=replace_me_with_a_random_secret_of_32_or_more_chars

# OAuth client ID of the web application from Google Cloud Console, empty disables Google sign-in
GOOGLE_CLIENT_ID=
# the same client ID for the web build, Vite exposes only VITE_* values to the frontend
VITE_GOOGLE_CLIENT_ID=
# report photo directory for `task api`, relative paths start in apps/api; the api container uses its volume instead
UPLOAD_DIR=uploads

# image tags and published ports of the api and web containers in docker-compose.app.yaml
API_IMAGE_TAG=dev
WEB_IMAGE_TAG=dev
API_PORT=8000
WEB_PORT=8080
VITE_API_URL=http://localhost:8000/

NOTIFY_IMAGE_TAG=dev
# internal HTTP port of notify
NOTIFY_PORT=8001

# gmail address used to log in and send mail from notify
SMTP_USER=replace_me@gmail.com
# gmail app password, without spaces; requires 2-step verification: https://support.google.com/mail/answer/185833
SMTP_PASSWORD=replace_me_with_a_gmail_app_password

# redirect every mail to the test address when true; false uses the recipient from the request
SMTP_MOCK=true
SMTP_MOCK_DESTINATION=replace_me@example.com

# optional local inference providers; install the API inference extra before setting paths
# task setup installs the extra and downloads models; paths are relative to apps/api
LAYA_MODEL_PATH=models/laya-vision
TRANSLATION_MODEL_PATH=models/opus-mt-pl-en
LAYA_DEVICE=cpu
LAYA_PERMUTATIONS=3
# correct text-only option bias using a neutral input; 0 disables correction
LAYA_CALIBRATION_STRENGTH=1
# enough space for the 15 service entity descriptions; inputs are never silently truncated
LAYA_LOAD_OPTIONS='{"head_max_len":768,"max_len":2048}'
TRANSLATION_SOURCE_LANGUAGE=pl
TRANSLATION_TARGET_LANGUAGE=en
# optional JSON question override; its criteria keys must exactly match ServiceEntityType
SERVICE_ENTITY_CRITERIA_PATH=
